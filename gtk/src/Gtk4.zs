module AccessibleAnnouncementPriority =
  /// The announcement is low priority, and might be read only on the user's request.
  let low = AccessibleAnnouncementPriority 0

  /// The announcement is of medium priority, and is usually spoken at the next opportunity, such as at the end of speaking the current sentence or when the user pauses typing.
  let medium = AccessibleAnnouncementPriority 1

  /// The announcement is of high priority, and is usually spoken immediately.
  let high = AccessibleAnnouncementPriority 2

module AccessibleAutocomplete =
  /// Automatic suggestions are not displayed.
  let none = AccessibleAutocomplete 0

  /// When a user is providing input, text suggesting one way to complete the provided input may be dynamically inserted after the caret.
  let inline = AccessibleAutocomplete 1

  /// When a user is providing input, an element containing a collection of values that could complete the provided input may be displayed.
  let list = AccessibleAutocomplete 2

  /// When a user is providing input, an element containing a collection of values that could complete the provided input may be displayed.
  let both = AccessibleAutocomplete 3

module AccessibleInvalidState =
  /// There are no detected errors in the value
  let false_ = AccessibleInvalidState 0

  /// The value entered by the user has failed validation
  let true_ = AccessibleInvalidState 1

  /// A grammatical error was detected
  let grammar = AccessibleInvalidState 2

  /// A spelling error was detected
  let spelling = AccessibleInvalidState 3

module AccessiblePlatformState =
  /// whether the accessible can be focused
  let focusable = AccessiblePlatformState 0

  /// whether the accessible has focus
  let focused = AccessiblePlatformState 1

  /// whether the accessible is active
  let active = AccessiblePlatformState 2

module AccessibleProperty =
  /// Indicates whether inputting text could trigger display of one or more predictions of the user's intended value for a combobox, searchbox, or textbox and specifies how predictions would be presented if they were made.
  let autocomplete = AccessibleProperty 0

  /// Defines a string value that describes or annotates the current element.
  let description = AccessibleProperty 1

  /// Indicates the availability of interactive popup element, such as menu or popover, that can be triggered by an element.
  let hasPopup = AccessibleProperty 2

  /// Indicates keyboard shortcuts that an author has implemented to activate or give focus to an element.
  let keyShortcuts = AccessibleProperty 3

  /// Defines a string value that labels the current element.
  let label = AccessibleProperty 4

  /// Defines the hierarchical level of an element within a structure.
  let level = AccessibleProperty 5

  /// Indicates whether an element is modal when displayed.
  let modal = AccessibleProperty 6

  /// Indicates whether a text box accepts multiple lines of input or only a single line.
  let multiLine = AccessibleProperty 7

  /// Indicates that the user may select more than one item from the current selectable descendants.
  let multiSelectable = AccessibleProperty 8

  /// Indicates whether the element's orientation is horizontal, vertical, or unknown/ambiguous.
  let orientation = AccessibleProperty 9

  /// Defines a short hint (a word or short phrase) intended to aid the user with data entry when the control has no value.
  let placeholder = AccessibleProperty 10

  /// Indicates that the element is not editable, but is otherwise operable.
  let readOnly = AccessibleProperty 11

  /// Indicates that user input is required on the element before a form may be submitted.
  let required = AccessibleProperty 12

  /// Defines a human-readable, author-localized description for the role of an element.
  let roleDescription = AccessibleProperty 13

  /// Indicates if items in a table or grid are sorted in ascending or descending order.
  let sort = AccessibleProperty 14

  /// Defines the maximum allowed value for a range widget.
  let valueMax = AccessibleProperty 15

  /// Defines the minimum allowed value for a range widget.
  let valueMin = AccessibleProperty 16

  /// Defines the current value for a range widget.
  let valueNow = AccessibleProperty 17

  /// Defines the human readable text alternative of [enum@Gtk.AccessibleProperty.VALUE_NOW] for a range widget.
  let valueText = AccessibleProperty 18

  /// Defines a string value that provides a description of non-standard keyboard interactions of the current element.
  let helpText = AccessibleProperty 19

module AccessibleRelation =
  /// Identifies the currently active element when focus is on a composite widget, combobox, textbox, group, or application.
  let activeDescendant = AccessibleRelation 0

  /// Defines the total number of columns in a table, grid, or treegrid.
  let colCount = AccessibleRelation 1

  /// Defines an element's column index or position with respect to the total number of columns within a table, grid, or treegrid.
  let colIndex = AccessibleRelation 2

  /// Defines a human readable text alternative of %GTK_ACCESSIBLE_RELATION_COL_INDEX.
  let colIndexText = AccessibleRelation 3

  /// Defines the number of columns spanned by a cell or gridcell within a table, grid, or treegrid.
  let colSpan = AccessibleRelation 4

  /// Identifies the element (or elements) whose contents or presence are controlled by the current element.
  let controls = AccessibleRelation 5

  /// Identifies the element (or elements) that describes the object.
  let describedBy = AccessibleRelation 6

  /// Identifies the element (or elements) that provide additional information related to the object.
  let details = AccessibleRelation 7

  /// Identifies the element (or elements) that provide an error message for an object.
  let errorMessage = AccessibleRelation 8

  /// Identifies the next element (or elements) in an alternate reading order of content which, at the user's discretion, allows assistive technology to override the general default of reading in document source order.
  let flowTo = AccessibleRelation 9

  /// Identifies the element (or elements) that labels the current element.
  let labelledBy = AccessibleRelation 10

  /// Identifies an element (or elements) in order to define a visual, functional, or contextual parent/child relationship between elements where the widget hierarchy cannot be used to represent the relationship.
  let owns = AccessibleRelation 11

  /// Defines an element's number or position in the current set of listitems or treeitems.
  let posInSet = AccessibleRelation 12

  /// Defines the total number of rows in a table, grid, or treegrid.
  let rowCount = AccessibleRelation 13

  /// Defines an element's row index or position with respect to the total number of rows within a table, grid, or treegrid.
  let rowIndex = AccessibleRelation 14

  /// Defines a human readable text alternative of [enum@Gtk.AccessibleRelation.ROW_INDEX].
  let rowIndexText = AccessibleRelation 15

  /// Defines the number of rows spanned by a cell or gridcell within a table, grid, or treegrid.
  let rowSpan = AccessibleRelation 16

  /// Defines the number of items in the current set of listitems or treeitems.
  let setSize = AccessibleRelation 17

  /// Identifies the element (or elements) that are labeled by the current element.
  let labelFor = AccessibleRelation 18

  /// Identifies the element (or elements) that are described by the current element.
  let descriptionFor = AccessibleRelation 19

  /// Identifies the element (or elements) that the current element is controlled by.
  let controlledBy = AccessibleRelation 20

  /// Identifies the element (or elements) for which the current element provides additional information.
  let detailsFor = AccessibleRelation 21

  /// Identifies the element (or elements) for which the current element provides an error message.
  let errorMessageFor = AccessibleRelation 22

  /// Identifies the previous element (or elements) in an alternate reading order of content which, at the user's discretion, allows assistive technology to override the general default of reading in document source order.
  let flowFrom = AccessibleRelation 23

module AccessibleRole =
  /// An element with important, and usually time-sensitive, information
  let alert = AccessibleRole 0

  /// A type of dialog that contains an alert message
  let alertDialog = AccessibleRole 1

  /// Unused
  let banner = AccessibleRole 2

  /// An input element that allows for user-triggered actions when clicked or pressed
  let button = AccessibleRole 3

  /// Unused
  let caption = AccessibleRole 4

  /// Unused
  let cell = AccessibleRole 5

  /// A checkable input element that has three possible values: `true`, `false`, or `mixed`
  let checkbox = AccessibleRole 6

  /// A header in a columned list.
  let columnHeader = AccessibleRole 7

  /// An input that controls another element, such as a list or a grid, that can dynamically pop up to help the user set the value of the input
  let comboBox = AccessibleRole 8

  /// Abstract role.
  let command = AccessibleRole 9

  /// Abstract role.
  let composite = AccessibleRole 10

  /// A dialog is a window that is designed to interrupt the current processing of an application in order to prompt the user to enter information or require a response.
  let dialog = AccessibleRole 11

