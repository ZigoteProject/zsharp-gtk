module SortListModel =
  /// The same object as its interface.
  let toGioListModel (self: SortListModel) : Gio.ListModel = Gio.ListModel self.Id

  /// The same object as its interface.
  let toSectionModel (self: SortListModel) : SectionModel = SectionModel self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: SortListModel) : GObject.Object = GObject.Object self.Id

  /// The type itself, for `Glue.subclass`, `Glue.isA` and a property's or a signal's types.
  let gtype () : usize = Internal.Gtk4C.gtk_sort_list_model_get_type ()

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<SortListModel> =
    if Internal.Raw.isA (Internal.Raw.obj object.Id (usize 0)) (Internal.Gtk4C.gtk_sort_list_model_get_type ()) then Some (SortListModel object.Id) else None

  /// Creates a new sort list model that uses the @sorter to sort @model.
  let create (model: option<Gio.ListModel>) (sorter: option<Sorter>) : SortListModel =
    let zp1 =
      match model with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.GioC.g_list_model_get_type ()))
      | None -> Internal.Raw.none ()
    let zp2 =
      match sorter with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.Gtk4C.gtk_sorter_get_type ()))
      | None -> Internal.Raw.none ()
    let zr = Internal.Gtk4C.gtk_sort_list_model_new zp1 zp2
    SortListModel (Internal.Raw.wrap (zr) true)

  /// Returns whether incremental sorting is enabled.
  let getIncremental (self: SortListModel) : bool =
    (((Internal.Gtk4C.gtk_sort_list_model_get_incremental (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_sort_list_model_get_type ())))) <> i32 0)

  /// Gets the model currently sorted or %NULL if none.
  let getModel (self: SortListModel) : option<Gio.ListModel> =
    let zr = Internal.Gtk4C.gtk_sort_list_model_get_model (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_sort_list_model_get_type ()))
    let zid1 = Internal.Raw.wrap (zr) false
    (if zid1 = 0 then None else Some (Gio.ListModel zid1))

  /// Estimates progress of an ongoing sorting operation.
  let getPending (self: SortListModel) : int =
    (int ((Internal.Gtk4C.gtk_sort_list_model_get_pending (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_sort_list_model_get_type ())))))

  /// Gets the section sorter that is used to sort items of @self into sections.
  let getSectionSorter (self: SortListModel) : option<Sorter> =
    let zr = Internal.Gtk4C.gtk_sort_list_model_get_section_sorter (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_sort_list_model_get_type ()))
    let zid1 = Internal.Raw.wrap (zr) false
    (if zid1 = 0 then None else Some (Sorter zid1))

  /// Gets the sorter that is used to sort @self.
  let getSorter (self: SortListModel) : option<Sorter> =
    let zr = Internal.Gtk4C.gtk_sort_list_model_get_sorter (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_sort_list_model_get_type ()))
    let zid1 = Internal.Raw.wrap (zr) false
    (if zid1 = 0 then None else Some (Sorter zid1))

