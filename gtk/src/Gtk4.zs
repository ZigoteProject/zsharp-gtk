  /// Reads the print settings from the group @group_name in @key_file.
  let createFromKeyFile (keyFile: GLib.KeyFile) (groupName: option<string>) : result<PrintSettings, Glue.Error> =
    let zs1 = Glue.dupOption groupName
    Glue.outBegin ()
    let zr = gtk_print_settings_new_from_key_file (Glue.obj keyFile.Id (GLib.g_key_file_get_type ())) zs1 (Glue.err ())
    match Glue.takeError () with
    | Some ze ->
      Glue.outEnd ()
      Glue.free zs1
      Error ze
    | None ->
      let zv = PrintSettings (Glue.wrap (zr) true)
      Glue.outEnd ()
      Glue.free zs1
      Ok zv

