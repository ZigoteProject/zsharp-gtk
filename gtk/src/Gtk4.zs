module Shortcut =
  /// The same object as its ancestor.
  let toGObjectObject (self: Shortcut) : GObject.Object = GObject.Object self.Id

  /// The type itself, for `Glue.subclass`, `Glue.isA` and a property's or a signal's types.
  let gtype () : usize = Internal.Gtk4C.gtk_shortcut_get_type ()

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<Shortcut> =
    if Internal.Raw.isA (Internal.Raw.obj object.Id (usize 0)) (Internal.Gtk4C.gtk_shortcut_get_type ()) then Some (Shortcut object.Id) else None

  /// Creates a new `GtkShortcut` that is triggered by @trigger and then activates @action.
  let create (trigger: option<ShortcutTrigger>) (action: option<ShortcutAction>) : Shortcut =
    let zp1 =
      match trigger with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.Gtk4C.gtk_shortcut_trigger_get_type ()))
      | None -> Internal.Raw.none ()
    let zp2 =
      match action with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.Gtk4C.gtk_shortcut_action_get_type ()))
      | None -> Internal.Raw.none ()
    let zr = Internal.Gtk4C.gtk_shortcut_new zp1 zp2
    Shortcut (Internal.Raw.wrap (zr) true)

  /// Gets the action that is activated by this shortcut.
  let getAction (self: Shortcut) : option<ShortcutAction> =
    let zr = Internal.Gtk4C.gtk_shortcut_get_action (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ()))
    let zid1 = Internal.Raw.wrap (zr) false
    (if zid1 = 0 then None else Some (ShortcutAction zid1))

  /// Gets the arguments that are passed when activating the shortcut.
  let getArguments (self: Shortcut) : option<GLib.Variant> =
    let zr = Internal.Gtk4C.gtk_shortcut_get_arguments (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ()))
    let zid1 = Internal.GLibC.zgtk_wrap_GLib_Variant (zr) (i32 0)
    (if zid1 = 0 then None else Some (GLib.Variant zid1))

  /// Gets the trigger used to trigger @self.
  let getTrigger (self: Shortcut) : option<ShortcutTrigger> =
    let zr = Internal.Gtk4C.gtk_shortcut_get_trigger (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ()))
    let zid1 = Internal.Raw.wrap (zr) false
    (if zid1 = 0 then None else Some (ShortcutTrigger zid1))

  /// Sets the new action for @self to be @action.
  let setAction (self: Shortcut) (action: option<ShortcutAction>) : unit =
    let zp1 =
      match action with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.Gtk4C.gtk_shortcut_action_get_type ()))
      | None -> Internal.Raw.none ()
    Internal.Gtk4C.gtk_shortcut_set_action (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) zp1

  /// Sets the arguments to pass when activating the shortcut.
  let setArguments (self: Shortcut) (args: option<GLib.Variant>) : unit =
    let zp1 =
      match args with
      | Some zo -> Internal.Raw.obj zo.Id (Internal.GLibC.zgtk_type_GLib_Variant ())
      | None -> Internal.Raw.none ()
    Internal.Gtk4C.gtk_shortcut_set_arguments (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) zp1

  /// Sets the new trigger for @self to be @trigger.
  let setTrigger (self: Shortcut) (trigger: option<ShortcutTrigger>) : unit =
    let zp1 =
      match trigger with
      | Some zo -> Internal.Raw.give (Internal.Raw.obj zo.Id (Internal.Gtk4C.gtk_shortcut_trigger_get_type ()))
      | None -> Internal.Raw.none ()
    Internal.Gtk4C.gtk_shortcut_set_trigger (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) zp1

  /// Calls `handler` when the `action` property changes.
  let onNotifyAction (self: Shortcut) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) "notify::action" handler

  /// Calls `handler` when the `arguments` property changes.
  let onNotifyArguments (self: Shortcut) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) "notify::arguments" handler

  /// Calls `handler` when the `trigger` property changes.
  let onNotifyTrigger (self: Shortcut) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_get_type ())) "notify::trigger" handler

module ShortcutController =
  /// The same object as its interface.
  let toGioListModel (self: ShortcutController) : Gio.ListModel = Gio.ListModel self.Id

  /// The same object as its interface.
  let toBuildable (self: ShortcutController) : Buildable = Buildable self.Id

  /// The same object as its ancestor.
  let toEventController (self: ShortcutController) : EventController = EventController self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: ShortcutController) : GObject.Object = GObject.Object self.Id

  /// The type itself, for `Glue.subclass`, `Glue.isA` and a property's or a signal's types.
  let gtype () : usize = Internal.Gtk4C.gtk_shortcut_controller_get_type ()

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<ShortcutController> =
    if Internal.Raw.isA (Internal.Raw.obj object.Id (usize 0)) (Internal.Gtk4C.gtk_shortcut_controller_get_type ()) then Some (ShortcutController object.Id) else None

  /// Creates a new shortcut controller.
  let create () : ShortcutController =
    ShortcutController (Internal.Raw.wrap ((Internal.Gtk4C.gtk_shortcut_controller_new ())) true)

  /// Creates a new shortcut controller that takes its shortcuts from the given list model.
  let createForModel (model: Gio.ListModel) : ShortcutController =
    ShortcutController (Internal.Raw.wrap ((Internal.Gtk4C.gtk_shortcut_controller_new_for_model (Internal.Raw.obj model.Id (Internal.GioC.g_list_model_get_type ())))) true)

  /// Adds @shortcut to the list of shortcuts handled by @self.
  let addShortcut (self: ShortcutController) (shortcut: Shortcut) : unit =
    Internal.Gtk4C.gtk_shortcut_controller_add_shortcut (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) (Internal.Raw.give (Internal.Raw.obj shortcut.Id (Internal.Gtk4C.gtk_shortcut_get_type ())))

  /// Gets the mnemonics modifiers for when this controller activates its shortcuts.
  let getMnemonicsModifiers (self: ShortcutController) : Gdk.ModifierType =
    Gdk.ModifierType (int ((Internal.Gtk4C.gtk_shortcut_controller_get_mnemonics_modifiers (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())))))

  /// Gets the scope for when this controller activates its shortcuts.
  let getScope (self: ShortcutController) : ShortcutScope =
    ShortcutScope (int ((Internal.Gtk4C.gtk_shortcut_controller_get_scope (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())))))

  /// Removes @shortcut from the list of shortcuts handled by @self.
  let removeShortcut (self: ShortcutController) (shortcut: Shortcut) : unit =
    Internal.Gtk4C.gtk_shortcut_controller_remove_shortcut (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) (Internal.Raw.obj shortcut.Id (Internal.Gtk4C.gtk_shortcut_get_type ()))

  /// Sets the controller to use the given modifier for mnemonics.
  let setMnemonicsModifiers (self: ShortcutController) (modifiers: Gdk.ModifierType) : unit =
    Internal.Gtk4C.gtk_shortcut_controller_set_mnemonics_modifiers (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) (u32 modifiers.Int)

  /// Sets the controller to have the given @scope.
  let setScope (self: ShortcutController) (scope: ShortcutScope) : unit =
    Internal.Gtk4C.gtk_shortcut_controller_set_scope (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) (i32 scope.Int)

  /// Calls `handler` when the `item-type` property changes.
  let onNotifyItemType (self: ShortcutController) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) "notify::item-type" handler

  /// Calls `handler` when the `mnemonic-modifiers` property changes.
  let onNotifyMnemonicModifiers (self: ShortcutController) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) "notify::mnemonic-modifiers" handler

  /// Calls `handler` when the `model` property changes.
  let onNotifyModel (self: ShortcutController) (handler: unit -> unit) : unit =
    Internal.Raw.connect (Internal.Raw.obj self.Id (Internal.Gtk4C.gtk_shortcut_controller_get_type ())) "notify::model" handler

  /// Calls `handler` when the `n-items` property changes.
