module Image =
  /// The same object as its interface.
  let toAccessible (self: Image) : Accessible = Accessible self.Id

  /// The same object as its interface.
  let toBuildable (self: Image) : Buildable = Buildable self.Id

  /// The same object as its interface.
  let toConstraintTarget (self: Image) : ConstraintTarget = ConstraintTarget self.Id

  /// The same object as its ancestor.
  let toWidget (self: Image) : Widget = Widget self.Id

  /// The same object as its ancestor.
  let toGObjectInitiallyUnowned (self: Image) : GObject.InitiallyUnowned = GObject.InitiallyUnowned self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: Image) : GObject.Object = GObject.Object self.Id

  /// The type itself, for `Glue.subclass`, `Glue.isA` and a property's or a signal's types.
