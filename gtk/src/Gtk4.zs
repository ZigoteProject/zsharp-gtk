module AboutDialog =
  /// The same object as its interface.
  let toAccessible (self: AboutDialog) : Accessible = Accessible self.Id

  /// The same object as its interface.
  let toBuildable (self: AboutDialog) : Buildable = Buildable self.Id

  /// The same object as its interface.
  let toConstraintTarget (self: AboutDialog) : ConstraintTarget = ConstraintTarget self.Id

  /// The same object as its interface.
  let toNative (self: AboutDialog) : Native = Native self.Id

  /// The same object as its interface.
  let toRoot (self: AboutDialog) : Root = Root self.Id

  /// The same object as its interface.
  let toShortcutManager (self: AboutDialog) : ShortcutManager = ShortcutManager self.Id

  /// The same object as its ancestor.
  let toWindow (self: AboutDialog) : Window = Window self.Id

  /// The same object as its ancestor.
  let toWidget (self: AboutDialog) : Widget = Widget self.Id

  /// The same object as its ancestor.
  let toGObjectInitiallyUnowned (self: AboutDialog) : GObject.InitiallyUnowned = GObject.InitiallyUnowned self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: AboutDialog) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<AboutDialog> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_about_dialog_get_type ()) then Some (AboutDialog object.Id) else None

  extern gtk_about_dialog_new : unit -> cptr

  /// Creates a new `GtkAboutDialog`.
  let create () : AboutDialog =
    AboutDialog (Glue.wrap ((gtk_about_dialog_new ())) false)

  extern gtk_about_dialog_add_credit_section : cptr -> cstr -> cptr -> unit

  /// Creates a new section in the "Credits" page.
  let addCreditSection (self: AboutDialog) (sectionName: string) (people: list<string>) : unit =
    let zv1 = Glue.strv people
    gtk_about_dialog_add_credit_section (Glue.obj self.Id (gtk_about_dialog_get_type ())) sectionName zv1
    Glue.freeStrv zv1

