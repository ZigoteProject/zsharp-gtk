module CellRendererCombo =
  /// The same object as its ancestor.
  let toCellRendererText (self: CellRendererCombo) : CellRendererText = CellRendererText self.Id

  /// The same object as its ancestor.
  let toCellRenderer (self: CellRendererCombo) : CellRenderer = CellRenderer self.Id

  /// The same object as its ancestor.
  let toGObjectInitiallyUnowned (self: CellRendererCombo) : GObject.InitiallyUnowned = GObject.InitiallyUnowned self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: CellRendererCombo) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<CellRendererCombo> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_cell_renderer_combo_get_type ()) then Some (CellRendererCombo object.Id) else None

  extern gtk_cell_renderer_combo_new : unit -> cptr

  /// Deprecated. Creates a new `GtkCellRendererCombo`.
  let create () : CellRendererCombo =
    CellRendererCombo (Glue.wrap ((gtk_cell_renderer_combo_new ())) false)

  /// This signal is emitted each time after the user selected an item in the combo box, either by using the mouse or the arrow keys.
  let onChanged (self: CellRendererCombo) (handler: string -> TreeIter -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "changed" (fun () ->
      let pathString = Glue.text (Glue.argPointer 1)
      let newIter = TreeIter (Glue.wrapBoxed (Glue.argPointer 2) (gtk_tree_iter_get_type ()) false)
      handler pathString newIter)

  /// Calls `handler` when the `has-entry` property changes.
  let onNotifyHasEntry (self: CellRendererCombo) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "notify::has-entry" handler

  /// The `has-entry` property.
  let getHasEntry (self: CellRendererCombo) : bool = (Glue.getInt (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "has-entry" <> 0)

  /// Sets the `has-entry` property.
  let setHasEntry (self: CellRendererCombo) (value: bool) : unit = Glue.setInt (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "has-entry" (if value then 1 else 0)

  /// Calls `handler` when the `model` property changes.
  let onNotifyModel (self: CellRendererCombo) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "notify::model" handler

  /// The `model` property.
  let getModel (self: CellRendererCombo) : option<TreeModel> =
    let zid = Glue.getObject (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "model"
    if zid = 0 then None else Some (TreeModel zid)

  /// Sets the `model` property.
  let setModel (self: CellRendererCombo) (value: TreeModel) : unit = Glue.setObject (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "model" (Glue.obj value.Id (gtk_tree_model_get_type ()))

  /// Calls `handler` when the `text-column` property changes.
  let onNotifyTextColumn (self: CellRendererCombo) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "notify::text-column" handler

  /// The `text-column` property.
  let getTextColumn (self: CellRendererCombo) : int = Glue.getInt (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "text-column"

  /// Sets the `text-column` property.
  let setTextColumn (self: CellRendererCombo) (value: int) : unit = Glue.setInt (Glue.obj self.Id (gtk_cell_renderer_combo_get_type ())) "text-column" value

