  extern gtk_print_settings_new_from_file : cstr -> cptr -> cptr

  /// Reads the print settings from @file_name.
  let createFromFile (fileName: string) : result<PrintSettings, Glue.Error> =
    Glue.outBegin ()
    let zr = gtk_print_settings_new_from_file fileName (Glue.err ())
    match Glue.takeError () with
    | Some ze ->
      Glue.outEnd ()
      Error ze
    | None ->
      let zv = PrintSettings (Glue.wrap (zr) true)
      Glue.outEnd ()
      Ok zv

