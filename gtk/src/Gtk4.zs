module Shortcut =
  /// The same object as its ancestor.
  let toGObjectObject (self: Shortcut) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<Shortcut> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_shortcut_get_type ()) then Some (Shortcut object.Id) else None

  extern gtk_shortcut_new : cptr -> cptr -> cptr

  /// Creates a new `GtkShortcut` that is triggered by @trigger and then activates @action.
  let create (trigger: option<ShortcutTrigger>) (action: option<ShortcutAction>) : Shortcut =
    let zp1 =
      match trigger with
      | Some zo -> Glue.give (Glue.obj zo.Id (gtk_shortcut_trigger_get_type ()))
      | None -> Glue.none ()
    let zp2 =
      match action with
      | Some zo -> Glue.give (Glue.obj zo.Id (gtk_shortcut_action_get_type ()))
      | None -> Glue.none ()
    let zr = gtk_shortcut_new zp1 zp2
    Shortcut (Glue.wrap (zr) true)

  /// Creates a new `GtkShortcut` that is triggered by @trigger and then activates @action with arguments given by @format_string. C's own function, of variable arguments: called as C calls it, by code that
  /// answers for what it passes.
  extern gtk_shortcut_new_with_arguments : cptr -> cptr -> cstr -> ... -> cptr

  extern gtk_shortcut_get_action : cptr -> cptr

  /// Gets the action that is activated by this shortcut.
  let getAction (self: Shortcut) : option<ShortcutAction> =
    let zr = gtk_shortcut_get_action (Glue.obj self.Id (gtk_shortcut_get_type ()))
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (ShortcutAction zid1))

  extern gtk_shortcut_get_arguments : cptr -> cptr

  /// Gets the arguments that are passed when activating the shortcut.
  let getArguments (self: Shortcut) : option<GLib.Variant> =
    let zr = gtk_shortcut_get_arguments (Glue.obj self.Id (gtk_shortcut_get_type ()))
    let zid1 = GLib.zgtk_wrap_GLib_Variant (zr) (i32 0)
    (if zid1 = 0 then None else Some (GLib.Variant zid1))

  extern gtk_shortcut_get_trigger : cptr -> cptr

  /// Gets the trigger used to trigger @self.
  let getTrigger (self: Shortcut) : option<ShortcutTrigger> =
    let zr = gtk_shortcut_get_trigger (Glue.obj self.Id (gtk_shortcut_get_type ()))
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (ShortcutTrigger zid1))

  extern gtk_shortcut_set_action : cptr -> cptr -> unit

  /// Sets the new action for @self to be @action.
  let setAction (self: Shortcut) (action: option<ShortcutAction>) : unit =
    let zp1 =
      match action with
      | Some zo -> Glue.give (Glue.obj zo.Id (gtk_shortcut_action_get_type ()))
      | None -> Glue.none ()
    gtk_shortcut_set_action (Glue.obj self.Id (gtk_shortcut_get_type ())) zp1

  extern gtk_shortcut_set_arguments : cptr -> cptr -> unit

  /// Sets the arguments to pass when activating the shortcut.
  let setArguments (self: Shortcut) (args: option<GLib.Variant>) : unit =
    let zp1 =
      match args with
      | Some zo -> Glue.obj zo.Id (GLib.zgtk_type_GLib_Variant ())
      | None -> Glue.none ()
    gtk_shortcut_set_arguments (Glue.obj self.Id (gtk_shortcut_get_type ())) zp1

  extern gtk_shortcut_set_trigger : cptr -> cptr -> unit

  /// Sets the new trigger for @self to be @trigger.
  let setTrigger (self: Shortcut) (trigger: option<ShortcutTrigger>) : unit =
    let zp1 =
      match trigger with
      | Some zo -> Glue.give (Glue.obj zo.Id (gtk_shortcut_trigger_get_type ()))
      | None -> Glue.none ()
    gtk_shortcut_set_trigger (Glue.obj self.Id (gtk_shortcut_get_type ())) zp1

  /// Calls `handler` when the `action` property changes.
  let onNotifyAction (self: Shortcut) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_get_type ())) "notify::action" handler

  /// Calls `handler` when the `arguments` property changes.
  let onNotifyArguments (self: Shortcut) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_get_type ())) "notify::arguments" handler

  /// Calls `handler` when the `trigger` property changes.
  let onNotifyTrigger (self: Shortcut) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_get_type ())) "notify::trigger" handler

module ShortcutController =
  /// The same object as its interface.
  let toGioListModel (self: ShortcutController) : Gio.ListModel = Gio.ListModel self.Id

  /// The same object as its interface.
  let toBuildable (self: ShortcutController) : Buildable = Buildable self.Id

  /// The same object as its ancestor.
  let toEventController (self: ShortcutController) : EventController = EventController self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: ShortcutController) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<ShortcutController> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_shortcut_controller_get_type ()) then Some (ShortcutController object.Id) else None

  extern gtk_shortcut_controller_new : unit -> cptr

  /// Creates a new shortcut controller.
  let create () : ShortcutController =
    ShortcutController (Glue.wrap ((gtk_shortcut_controller_new ())) true)

  extern gtk_shortcut_controller_new_for_model : cptr -> cptr

  /// Creates a new shortcut controller that takes its shortcuts from the given list model.
  let createForModel (model: Gio.ListModel) : ShortcutController =
    ShortcutController (Glue.wrap ((gtk_shortcut_controller_new_for_model (Glue.obj model.Id (Gio.g_list_model_get_type ())))) true)

  extern gtk_shortcut_controller_add_shortcut : cptr -> cptr -> unit

  /// Adds @shortcut to the list of shortcuts handled by @self.
  let addShortcut (self: ShortcutController) (shortcut: Shortcut) : unit =
    gtk_shortcut_controller_add_shortcut (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) (Glue.give (Glue.obj shortcut.Id (gtk_shortcut_get_type ())))

  extern gtk_shortcut_controller_get_mnemonics_modifiers : cptr -> u32

  /// Gets the mnemonics modifiers for when this controller activates its shortcuts.
  let getMnemonicsModifiers (self: ShortcutController) : Gdk.ModifierType =
    Gdk.ModifierType (int ((gtk_shortcut_controller_get_mnemonics_modifiers (Glue.obj self.Id (gtk_shortcut_controller_get_type ())))))

  extern gtk_shortcut_controller_get_scope : cptr -> i32

  /// Gets the scope for when this controller activates its shortcuts.
  let getScope (self: ShortcutController) : ShortcutScope =
    ShortcutScope (int ((gtk_shortcut_controller_get_scope (Glue.obj self.Id (gtk_shortcut_controller_get_type ())))))

  extern gtk_shortcut_controller_remove_shortcut : cptr -> cptr -> unit

  /// Removes @shortcut from the list of shortcuts handled by @self.
  let removeShortcut (self: ShortcutController) (shortcut: Shortcut) : unit =
    gtk_shortcut_controller_remove_shortcut (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) (Glue.obj shortcut.Id (gtk_shortcut_get_type ()))

  extern gtk_shortcut_controller_set_mnemonics_modifiers : cptr -> u32 -> unit

  /// Sets the controller to use the given modifier for mnemonics.
  let setMnemonicsModifiers (self: ShortcutController) (modifiers: Gdk.ModifierType) : unit =
    gtk_shortcut_controller_set_mnemonics_modifiers (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) (u32 modifiers.Int)

  extern gtk_shortcut_controller_set_scope : cptr -> i32 -> unit

  /// Sets the controller to have the given @scope.
  let setScope (self: ShortcutController) (scope: ShortcutScope) : unit =
    gtk_shortcut_controller_set_scope (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) (i32 scope.Int)

  /// Calls `handler` when the `item-type` property changes.
  let onNotifyItemType (self: ShortcutController) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "notify::item-type" handler

  /// Calls `handler` when the `mnemonic-modifiers` property changes.
  let onNotifyMnemonicModifiers (self: ShortcutController) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "notify::mnemonic-modifiers" handler

  /// Calls `handler` when the `model` property changes.
  let onNotifyModel (self: ShortcutController) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "notify::model" handler

  /// Calls `handler` when the `n-items` property changes.
  let onNotifyNItems (self: ShortcutController) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "notify::n-items" handler

  /// The `n-items` property.
  let getNItems (self: ShortcutController) : int = Glue.getInt (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "n-items"

  /// Calls `handler` when the `scope` property changes.
  let onNotifyScope (self: ShortcutController) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_shortcut_controller_get_type ())) "notify::scope" handler

