  extern gtk_paper_size_new_from_key_file : cptr -> cptr -> cptr -> cptr

  /// Reads a paper size from the group @group_name in the key file @key_file.
  let createFromKeyFile (keyFile: GLib.KeyFile) (groupName: option<string>) : result<PaperSize, Glue.Error> =
    let zs1 = Glue.dupOption groupName
    Glue.outBegin ()
    let zr = gtk_paper_size_new_from_key_file (Glue.obj keyFile.Id (GLib.g_key_file_get_type ())) zs1 (Glue.err ())
    match Glue.takeError () with
    | Some ze ->
      Glue.outEnd ()
      Glue.free zs1
      Error ze
    | None ->
      let zv = PaperSize (Glue.wrapBoxed (zr) (gtk_paper_size_get_type ()) true)
      Glue.outEnd ()
      Glue.free zs1
      Ok zv

