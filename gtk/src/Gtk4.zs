  extern zgtk_override_Gtk_CellRendererText_edited : usize -> cptr -> unit

  /// Gives a type made with `Glue.subclass` its own `edited`: a virtual method.
  let overrideEdited (gtype: usize) (handler: CellRendererText -> string -> string -> unit) : unit =
    let zcb =
      Glue.hold (fun () ->
        let cellRendererText = CellRendererText (Glue.wrap (Glue.argPointer 0) false)
        let path = Glue.text (Glue.argPointer 1)
        let newText = Glue.text (Glue.argPointer 2)
        handler cellRendererText path newText)
    zgtk_override_Gtk_CellRendererText_edited gtype zcb

  extern zgtk_parent_Gtk_CellRendererText_edited : cptr -> cstr -> cstr -> unit

  /// `zgtk_parent_Gtk_CellRendererText_edited`.
  let parentEdited (self: CellRendererText) (path: string) (newText: string) : unit =
    zgtk_parent_Gtk_CellRendererText_edited (Glue.obj self.Id (gtk_cell_renderer_text_get_type ())) path newText

module CellRendererAccel =
  /// The same object as its ancestor.
  let toCellRendererText (self: CellRendererAccel) : CellRendererText = CellRendererText self.Id

  /// The same object as its ancestor.
  let toCellRenderer (self: CellRendererAccel) : CellRenderer = CellRenderer self.Id

  /// The same object as its ancestor.
  let toGObjectInitiallyUnowned (self: CellRendererAccel) : GObject.InitiallyUnowned = GObject.InitiallyUnowned self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: CellRendererAccel) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<CellRendererAccel> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_cell_renderer_accel_get_type ()) then Some (CellRendererAccel object.Id) else None

  extern gtk_cell_renderer_accel_new : unit -> cptr

  /// Deprecated. Creates a new `GtkCellRendererAccel`.
  let create () : CellRendererAccel =
    CellRendererAccel (Glue.wrap ((gtk_cell_renderer_accel_new ())) false)

  /// Gets emitted when the user has removed the accelerator.
  let onAccelCleared (self: CellRendererAccel) (handler: string -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_accel_get_type ())) "accel-cleared" (fun () ->
      let pathString = Glue.text (Glue.argPointer 1)
      handler pathString)

  /// Gets emitted when the user has selected a new accelerator.
  let onAccelEdited (self: CellRendererAccel) (handler: string -> int -> Gdk.ModifierType -> int -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_accel_get_type ())) "accel-edited" (fun () ->
      let pathString = Glue.text (Glue.argPointer 1)
      let accelKey = Glue.argInt 2
      let accelMods = Gdk.ModifierType (int (Glue.argInt 3))
      let hardwareKeycode = Glue.argInt 4
      handler pathString accelKey accelMods hardwareKeycode)

  /// Calls `handler` when the `accel-key` property changes.
  let onNotifyAccelKey (self: CellRendererAccel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_cell_renderer_accel_get_type ())) "notify::accel-key" handler

