module TextTagTable =
  /// The same object as its interface.
  let toBuildable (self: TextTagTable) : Buildable = Buildable self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: TextTagTable) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<TextTagTable> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_text_tag_table_get_type ()) then Some (TextTagTable object.Id) else None

  extern gtk_text_tag_table_new : unit -> cptr

  /// Creates a new `GtkTextTagTable`.
  let create () : TextTagTable =
    TextTagTable (Glue.wrap ((gtk_text_tag_table_new ())) true)

  extern gtk_text_tag_table_add : cptr -> cptr -> i32

  /// Add a tag to the table.
  let add (self: TextTagTable) (tag: TextTag) : bool =
    (((gtk_text_tag_table_add (Glue.obj self.Id (gtk_text_tag_table_get_type ())) (Glue.obj tag.Id (gtk_text_tag_get_type ())))) <> i32 0)

  extern gtk_text_tag_table_foreach : cptr -> cptr -> cptr -> unit

  /// Calls @func on each tag in @table, with user data @data.
  let foreach (self: TextTagTable) (func: TextTag -> unit) : unit =
    let zcb1 =
      Glue.hold (fun () ->
        let tag = TextTag (Glue.wrap (Glue.argPointer 0) false)
        func tag)
    gtk_text_tag_table_foreach (Glue.obj self.Id (gtk_text_tag_table_get_type ())) (zgtk_tramp_Gtk_TextTagTableForeach ()) zcb1
    Glue.drop zcb1

  extern gtk_text_tag_table_get_size : cptr -> i32

  /// Returns the size of the table (number of tags)
  let getSize (self: TextTagTable) : int =
    (int ((gtk_text_tag_table_get_size (Glue.obj self.Id (gtk_text_tag_table_get_type ())))))

  extern gtk_text_tag_table_lookup : cptr -> cstr -> cptr

  /// Look up a named tag.
  let lookup (self: TextTagTable) (name: string) : option<TextTag> =
    let zr = gtk_text_tag_table_lookup (Glue.obj self.Id (gtk_text_tag_table_get_type ())) name
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (TextTag zid1))

  extern gtk_text_tag_table_remove : cptr -> cptr -> unit

  /// Remove a tag from the table.
  let remove (self: TextTagTable) (tag: TextTag) : unit =
    gtk_text_tag_table_remove (Glue.obj self.Id (gtk_text_tag_table_get_type ())) (Glue.obj tag.Id (gtk_text_tag_get_type ()))

  /// Emitted every time a new tag is added in the `GtkTextTagTable`.
  let onTagAdded (self: TextTagTable) (handler: TextTag -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_text_tag_table_get_type ())) "tag-added" (fun () ->
      let tag = TextTag (Glue.wrap (Glue.argPointer 1) false)
      handler tag)

  /// Emitted every time a tag in the `GtkTextTagTable` changes.
  let onTagChanged (self: TextTagTable) (handler: TextTag -> bool -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_text_tag_table_get_type ())) "tag-changed" (fun () ->
      let tag = TextTag (Glue.wrap (Glue.argPointer 1) false)
      let sizeChanged = (Glue.argInt 2 <> 0)
      handler tag sizeChanged)

  /// Emitted every time a tag is removed from the `GtkTextTagTable`.
