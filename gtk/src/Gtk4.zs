extern gtk_value_dup_expression : cptr -> cptr

/// Retrieves the `GtkExpression` stored inside the given `value`, and acquires a reference to it.
let valueDupExpression (value: GObject.Value) : option<Expression> =
  let zr = gtk_value_dup_expression (Glue.obj value.Id (GObject.g_value_get_type ()))
  let zid1 = zgtk_wrap_Gtk_Expression (zr) (i32 1)
  (if zid1 = 0 then None else Some (Expression zid1))

extern gtk_value_get_expression : cptr -> cptr

/// Retrieves the `GtkExpression` stored inside the given `value`.
let valueGetExpression (value: GObject.Value) : option<Expression> =
  let zr = gtk_value_get_expression (Glue.obj value.Id (GObject.g_value_get_type ()))
  let zid1 = zgtk_wrap_Gtk_Expression (zr) (i32 0)
  (if zid1 = 0 then None else Some (Expression zid1))

extern gtk_value_set_expression : cptr -> cptr -> unit

/// Stores the given `GtkExpression` inside `value`.
let valueSetExpression (value: GObject.Value) (expression: Expression) : unit =
  gtk_value_set_expression (Glue.obj value.Id (GObject.g_value_get_type ())) (Glue.obj expression.Id (zgtk_type_Gtk_Expression ()))

extern gtk_value_take_expression : cptr -> cptr -> unit

/// Stores the given `GtkExpression` inside `value`.
let valueTakeExpression (value: GObject.Value) (expression: option<Expression>) : unit =
  let zp1 =
    match expression with
    | Some zo -> zgtk_give_Gtk_Expression (Glue.obj zo.Id (zgtk_type_Gtk_Expression ()))
    | None -> Glue.none ()
  gtk_value_take_expression (Glue.obj value.Id (GObject.g_value_get_type ())) zp1
