  /// Copies an existing `GtkPaperSize`.
  let copy (self: PaperSize) : PaperSize =
    PaperSize (Glue.wrapBoxed ((gtk_paper_size_copy (Glue.obj self.Id (gtk_paper_size_get_type ())))) (gtk_paper_size_get_type ()) true)

  extern gtk_paper_size_free : cptr -> unit

  /// Free the given `GtkPaperSize` object.
  [<Unsafe>]
  let free (self: PaperSize) : unit =
    gtk_paper_size_free (Glue.obj self.Id (gtk_paper_size_get_type ()))

