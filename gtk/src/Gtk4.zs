module SortListModel =
  /// The same object as its interface.
  let toGioListModel (self: SortListModel) : Gio.ListModel = Gio.ListModel self.Id

  /// The same object as its interface.
  let toSectionModel (self: SortListModel) : SectionModel = SectionModel self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: SortListModel) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<SortListModel> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_sort_list_model_get_type ()) then Some (SortListModel object.Id) else None

  extern gtk_sort_list_model_new : cptr -> cptr -> cptr

  /// Creates a new sort list model that uses the @sorter to sort @model.
  let create (model: option<Gio.ListModel>) (sorter: option<Sorter>) : SortListModel =
    let zp1 =
      match model with
      | Some zo -> Glue.give (Glue.obj zo.Id (Gio.g_list_model_get_type ()))
      | None -> Glue.none ()
    let zp2 =
      match sorter with
      | Some zo -> Glue.give (Glue.obj zo.Id (gtk_sorter_get_type ()))
      | None -> Glue.none ()
    let zr = gtk_sort_list_model_new zp1 zp2
    SortListModel (Glue.wrap (zr) true)

  extern gtk_sort_list_model_get_incremental : cptr -> i32

  /// Returns whether incremental sorting is enabled.
  let getIncremental (self: SortListModel) : bool =
    (((gtk_sort_list_model_get_incremental (Glue.obj self.Id (gtk_sort_list_model_get_type ())))) <> i32 0)

  extern gtk_sort_list_model_get_model : cptr -> cptr

  /// Gets the model currently sorted or %NULL if none.
  let getModel (self: SortListModel) : option<Gio.ListModel> =
    let zr = gtk_sort_list_model_get_model (Glue.obj self.Id (gtk_sort_list_model_get_type ()))
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (Gio.ListModel zid1))

  extern gtk_sort_list_model_get_pending : cptr -> u32

  /// Estimates progress of an ongoing sorting operation.
  let getPending (self: SortListModel) : int =
    (int ((gtk_sort_list_model_get_pending (Glue.obj self.Id (gtk_sort_list_model_get_type ())))))

  extern gtk_sort_list_model_get_section_sorter : cptr -> cptr

  /// Gets the section sorter that is used to sort items of @self into sections.
  let getSectionSorter (self: SortListModel) : option<Sorter> =
    let zr = gtk_sort_list_model_get_section_sorter (Glue.obj self.Id (gtk_sort_list_model_get_type ()))
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (Sorter zid1))

  extern gtk_sort_list_model_get_sorter : cptr -> cptr

  /// Gets the sorter that is used to sort @self.
  let getSorter (self: SortListModel) : option<Sorter> =
    let zr = gtk_sort_list_model_get_sorter (Glue.obj self.Id (gtk_sort_list_model_get_type ()))
    let zid1 = Glue.wrap (zr) false
    (if zid1 = 0 then None else Some (Sorter zid1))

  extern gtk_sort_list_model_set_incremental : cptr -> i32 -> unit

  /// Sets the sort model to do an incremental sort.
  let setIncremental (self: SortListModel) (incremental: bool) : unit =
    gtk_sort_list_model_set_incremental (Glue.obj self.Id (gtk_sort_list_model_get_type ())) (if incremental then i32 1 else i32 0)

  extern gtk_sort_list_model_set_model : cptr -> cptr -> unit

  /// Sets the model to be sorted.
  let setModel (self: SortListModel) (model: option<Gio.ListModel>) : unit =
    let zp1 =
      match model with
      | Some zo -> Glue.obj zo.Id (Gio.g_list_model_get_type ())
      | None -> Glue.none ()
    gtk_sort_list_model_set_model (Glue.obj self.Id (gtk_sort_list_model_get_type ())) zp1

  extern gtk_sort_list_model_set_section_sorter : cptr -> cptr -> unit

  /// Sets a new section sorter on @self.
  let setSectionSorter (self: SortListModel) (sorter: option<Sorter>) : unit =
    let zp1 =
      match sorter with
      | Some zo -> Glue.obj zo.Id (gtk_sorter_get_type ())
      | None -> Glue.none ()
    gtk_sort_list_model_set_section_sorter (Glue.obj self.Id (gtk_sort_list_model_get_type ())) zp1

  extern gtk_sort_list_model_set_sorter : cptr -> cptr -> unit

  /// Sets a new sorter on @self.
  let setSorter (self: SortListModel) (sorter: option<Sorter>) : unit =
    let zp1 =
      match sorter with
      | Some zo -> Glue.obj zo.Id (gtk_sorter_get_type ())
      | None -> Glue.none ()
    gtk_sort_list_model_set_sorter (Glue.obj self.Id (gtk_sort_list_model_get_type ())) zp1

  /// Calls `handler` when the `incremental` property changes.
  let onNotifyIncremental (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::incremental" handler

  /// Calls `handler` when the `item-type` property changes.
  let onNotifyItemType (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::item-type" handler

  /// Calls `handler` when the `model` property changes.
  let onNotifyModel (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::model" handler

  /// Calls `handler` when the `n-items` property changes.
  let onNotifyNItems (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::n-items" handler

  /// The `n-items` property.
  let getNItems (self: SortListModel) : int = Glue.getInt (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "n-items"

  /// Calls `handler` when the `pending` property changes.
  let onNotifyPending (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::pending" handler

  /// Calls `handler` when the `section-sorter` property changes.
  let onNotifySectionSorter (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::section-sorter" handler

  /// Calls `handler` when the `sorter` property changes.
  let onNotifySorter (self: SortListModel) (handler: unit -> unit) : unit =
    Glue.connect (Glue.obj self.Id (gtk_sort_list_model_get_type ())) "notify::sorter" handler

