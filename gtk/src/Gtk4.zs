module Image =
  /// The same object as its interface.
  let toAccessible (self: Image) : Accessible = Accessible self.Id

  /// The same object as its interface.
  let toBuildable (self: Image) : Buildable = Buildable self.Id

  /// The same object as its interface.
  let toConstraintTarget (self: Image) : ConstraintTarget = ConstraintTarget self.Id

  /// The same object as its ancestor.
  let toWidget (self: Image) : Widget = Widget self.Id

  /// The same object as its ancestor.
  let toGObjectInitiallyUnowned (self: Image) : GObject.InitiallyUnowned = GObject.InitiallyUnowned self.Id

  /// The same object as its ancestor.
  let toGObjectObject (self: Image) : GObject.Object = GObject.Object self.Id

  /// The object as this type, if it is one.
  let cast (object: GObject.Object) : option<Image> =
    if Glue.isA (Glue.obj object.Id (usize 0)) (gtk_image_get_type ()) then Some (Image object.Id) else None

  extern gtk_image_new : unit -> cptr

  /// Creates a new empty `GtkImage` widget.
  let create () : Image =
    Image (Glue.wrap ((gtk_image_new ())) false)

  extern gtk_image_new_from_file : cstr -> cptr

  /// Creates a new `GtkImage` displaying the file @filename.
  let createFromFile (filename: string) : Image =
    Image (Glue.wrap ((gtk_image_new_from_file filename)) false)

  extern gtk_image_new_from_gicon : cptr -> cptr

  /// Creates a `GtkImage` displaying an icon from the current icon theme.
  let createFromGicon (icon: Gio.Icon) : Image =
    Image (Glue.wrap ((gtk_image_new_from_gicon (Glue.obj icon.Id (Gio.g_icon_get_type ())))) false)

  extern gtk_image_new_from_icon_name : cptr -> cptr

  /// Creates a `GtkImage` displaying an icon from the current icon theme.
  let createFromIconName (iconName: option<string>) : Image =
    let zs1 = Glue.dupOption iconName
    let zr = gtk_image_new_from_icon_name zs1
    let zv = Image (Glue.wrap (zr) false)
    Glue.free zs1
    zv

  extern gtk_image_new_from_paintable : cptr -> cptr

  /// Creates a new `GtkImage` displaying @paintable.
  let createFromPaintable (paintable: option<Gdk.Paintable>) : Image =
    let zp1 =
      match paintable with
      | Some zo -> Glue.obj zo.Id (Gdk.gdk_paintable_get_type ())
