  /// Creates a new `GtkConstraintLayout` layout manager.
  let create () : ConstraintLayout =
    ConstraintLayout (Glue.wrap ((gtk_constraint_layout_new ())) true)

  extern gtk_constraint_layout_add_constraint : cptr -> cptr -> unit

  /// Adds a constraint to the layout manager.
  let addConstraint (self: ConstraintLayout) (constraint: Constraint) : unit =
    gtk_constraint_layout_add_constraint (Glue.obj self.Id (gtk_constraint_layout_get_type ())) (Glue.give (Glue.obj constraint.Id (gtk_constraint_get_type ())))

  extern gtk_constraint_layout_add_constraints_from_descriptionv : cptr -> cptr -> usize -> i32 -> i32 -> cptr -> cptr -> cptr

  /// Creates a list of constraints from a VFL description.
  let addConstraintsFromDescription (self: ConstraintLayout) (lines: list<string>) (hspacing: int) (vspacing: int) (views: GLib.HashTable) : result<list<Constraint>, Glue.Error> =
    let zv2 = Glue.strv lines
    Glue.outBegin ()
    let zr = gtk_constraint_layout_add_constraints_from_descriptionv (Glue.obj self.Id (gtk_constraint_layout_get_type ())) zv2 (usize (Glue.count lines)) (i32 hspacing) (i32 vspacing) (Glue.obj views.Id (GLib.g_hash_table_get_type ())) (Glue.err ())
    match Glue.takeError () with
    | Some ze ->
      Glue.outEnd ()
      Glue.freeStrv zv2
      Error ze
    | None ->
      let zv = Glue.mapList (fun zp -> Constraint (Glue.wrap (zp) false)) (Glue.pointers (zr) false true)
      Glue.outEnd ()
      Glue.freeStrv zv2
      Ok zv

