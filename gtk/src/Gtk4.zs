  let create (name: option<string>) : PaperSize =
    let zs1 = Glue.dupOption name
    let zr = gtk_paper_size_new zs1
    let zv = PaperSize (Glue.wrapBoxed (zr) (gtk_paper_size_get_type ()) true)
    Glue.free zs1
    zv

