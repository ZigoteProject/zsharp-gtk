    DateTime (Glue.wrapBoxed ((g_date_time_new_from_timeval_local (Glue.obj tv.Id (zgtk_tag_GLib_TimeVal ())))) (g_date_time_get_type ()) true)

  extern g_date_time_new_from_timeval_utc : cptr -> cptr

