module Rand =
  extern g_rand_new : unit -> cptr

  /// Creates a new random number generator initialized with a seed taken either from `/dev/urandom` (if existing) or from the current time (as a fallback).
  let create () : Rand =
    Rand (Glue.wrapBoxed ((g_rand_new ())) (g_rand_get_type ()) true)

  extern g_rand_new_with_seed : u32 -> cptr

  /// Creates a new random number generator initialized with @seed.
  let createWithSeed (seed: int) : Rand =
    Rand (Glue.wrapBoxed ((g_rand_new_with_seed (u32 seed))) (g_rand_get_type ()) true)

  extern g_rand_new_with_seed_array : u32 -> u32 -> cptr

  /// Creates a new random number generator initialized with @seed.
  let createWithSeedArray (seed: int) (seedLength: int) : Rand =
    Rand (Glue.wrapBoxed ((g_rand_new_with_seed_array (u32 seed) (u32 seedLength))) (g_rand_get_type ()) true)

  extern g_rand_copy : cptr -> cptr

  /// Copies a #GRand into a new one with the same exact state as before.
  let copy (self: Rand) : Rand =
    Rand (Glue.wrapBoxed ((g_rand_copy (Glue.obj self.Id (g_rand_get_type ())))) (g_rand_get_type ()) true)

  extern g_rand_double : cptr -> f64

  /// Returns the next random #gdouble from @rand_ equally distributed over the range [0..1).
  let double (self: Rand) : float =
    ((g_rand_double (Glue.obj self.Id (g_rand_get_type ()))))

  extern g_rand_double_range : cptr -> f64 -> f64 -> f64

  /// Returns the next random #gdouble from @rand_ equally distributed over the range [@begin..@end).
  let doubleRange (self: Rand) (begin: float) (end: float) : float =
    ((g_rand_double_range (Glue.obj self.Id (g_rand_get_type ())) begin end))

  extern g_rand_free : cptr -> unit

  /// Frees the memory allocated for the #GRand.
  [<Unsafe>]
  let free (self: Rand) : unit =
    g_rand_free (Glue.obj self.Id (g_rand_get_type ()))

  extern g_rand_int : cptr -> u32

  /// Returns the next random #guint32 from @rand_ equally distributed over the range [0..2^32-1].
  let int_ (self: Rand) : int =
    (int ((g_rand_int (Glue.obj self.Id (g_rand_get_type ())))))

  extern g_rand_int_range : cptr -> i32 -> i32 -> i32

  /// Returns the next random #gint32 from @rand_ equally distributed over the range [@begin..@end-1].
  let intRange (self: Rand) (begin: int) (end: int) : int =
    (int ((g_rand_int_range (Glue.obj self.Id (g_rand_get_type ())) (i32 begin) (i32 end))))

  extern g_rand_set_seed : cptr -> u32 -> unit

  /// Sets the seed for the random number generator #GRand to @seed.
  let setSeed (self: Rand) (seed: int) : unit =
    g_rand_set_seed (Glue.obj self.Id (g_rand_get_type ())) (u32 seed)

  extern g_rand_set_seed_array : cptr -> u32 -> u32 -> unit

  /// Initializes the random number generator by an array of longs.
  let setSeedArray (self: Rand) (seed: int) (seedLength: int) : unit =
    g_rand_set_seed_array (Glue.obj self.Id (g_rand_get_type ())) (u32 seed) (u32 seedLength)

module RecMutex =
  extern g_rec_mutex_clear : cptr -> unit

  /// Frees the resources allocated to a recursive mutex with g_rec_mutex_init().
  let clear (self: RecMutex) : unit =
    g_rec_mutex_clear (Glue.obj self.Id (zgtk_tag_GLib_RecMutex ()))

  extern g_rec_mutex_init : cptr -> unit

  /// Initializes a #GRecMutex so that it can be used.
  let init (self: RecMutex) : unit =
    g_rec_mutex_init (Glue.obj self.Id (zgtk_tag_GLib_RecMutex ()))

  extern g_rec_mutex_lock : cptr -> unit

  /// Locks @rec_mutex.
  let lock (self: RecMutex) : unit =
    g_rec_mutex_lock (Glue.obj self.Id (zgtk_tag_GLib_RecMutex ()))

  extern g_rec_mutex_trylock : cptr -> i32

  /// Tries to lock @rec_mutex.
  let trylock (self: RecMutex) : bool =
    (((g_rec_mutex_trylock (Glue.obj self.Id (zgtk_tag_GLib_RecMutex ())))) <> i32 0)

  extern g_rec_mutex_unlock : cptr -> unit

  /// Unlocks @rec_mutex.
  let unlock (self: RecMutex) : unit =
    g_rec_mutex_unlock (Glue.obj self.Id (zgtk_tag_GLib_RecMutex ()))

  /// A new one, every field zero.
  let create () : RecMutex = RecMutex (Glue.allocPlain (zgtk_sizeof_GLib_RecMutex ()) (zgtk_tag_GLib_RecMutex ()))

