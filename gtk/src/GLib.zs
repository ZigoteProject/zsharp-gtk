    | None ->
      let zid3 = Glue.wrapBoxed (Glue.outPtr 0) (g_match_info_get_type ()) true
      let zv = (((zr) <> i32 0), (if zid3 = 0 then None else Some (MatchInfo zid3)))
      Glue.outEnd ()
