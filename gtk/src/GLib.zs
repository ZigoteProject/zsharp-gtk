  /// like %G_NORMALIZE_ALL, but with composed forms rather than a maximally decomposed form
  let allCompose = NormalizeMode 3

  /// another name for %G_NORMALIZE_ALL_COMPOSE
  let nfkc = NormalizeMode 3

