module Relation =
  extern g_relation_count : cptr -> cptr -> i32 -> i32

  /// Deprecated. Returns the number of tuples in a #GRelation that have the given value in the given field.
  [<Unsafe>]
  let count (self: Relation) (key: cptr) (field: int) : int =
    (int ((g_relation_count self.Ptr key (i32 field))))

  extern g_relation_delete : cptr -> cptr -> i32 -> i32

  /// Deprecated. Deletes any records from a #GRelation that have the given key value in the given field.
  [<Unsafe>]
  let delete (self: Relation) (key: cptr) (field: int) : int =
    (int ((g_relation_delete self.Ptr key (i32 field))))

  extern g_relation_destroy : cptr -> unit

  /// Deprecated. Destroys the #GRelation, freeing all memory allocated.
  [<Unsafe>]
  let destroy (self: Relation) : unit =
    g_relation_destroy self.Ptr

  /// Deprecated. Returns %TRUE if a record with the given values exists in a #GRelation. C's own function, of variable arguments: called as C calls it, by code that
  /// answers for what it passes.
  extern g_relation_exists : cptr -> ... -> i32

  extern g_relation_index : cptr -> i32 -> cptr -> cptr -> unit

  /// Deprecated. Creates an index on the given field.
  [<Unsafe>]
  let index (self: Relation) (field: int) (hashFunc: cptr) (keyEqualFunc: cptr) : unit =
    g_relation_index self.Ptr (i32 field) hashFunc keyEqualFunc

  /// Deprecated. Inserts a record into a #GRelation. C's own function, of variable arguments: called as C calls it, by code that
  /// answers for what it passes.
  extern g_relation_insert : cptr -> ... -> unit

  extern g_relation_print : cptr -> unit

  /// Deprecated. Outputs information about all records in a #GRelation, as well as the indexes.
  [<Unsafe>]
  let print (self: Relation) : unit =
    g_relation_print self.Ptr

  extern g_relation_select : cptr -> cptr -> i32 -> cptr

  /// Deprecated. Returns all of the tuples which have the given key in the given field.
  [<Unsafe>]
  let select (self: Relation) (key: cptr) (field: int) : Tuples =
    Tuples (Glue.copyPlain ((g_relation_select self.Ptr key (i32 field))) (zgtk_sizeof_GLib_Tuples ()) (zgtk_tag_GLib_Tuples ()))

  extern g_relation_new : i32 -> cptr

  /// Deprecated. Creates a new #GRelation with the given number of fields.
  let create (fields: int) : Relation =
    Relation ((g_relation_new (i32 fields)))

module SList =
  extern g_slist_alloc : unit -> cptr

  /// Allocates space for one #GSList element.
  let alloc () : list<cptr> =
    (Glue.pointers ((g_slist_alloc ())) true false)

  extern g_slist_append : cptr -> cptr -> cptr

  /// Adds a new element on to the end of the list.
  [<Unsafe>]
  let append (list: list<cptr>) (data: cptr) : list<cptr> =
    let zl1 = Glue.glist list true
    let zr = g_slist_append zl1 data
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    zv

  extern g_slist_concat : cptr -> cptr -> cptr

  /// Adds the second #GSList onto the end of the first #GSList.
  [<Unsafe>]
  let concat (list1: list<cptr>) (list2: list<cptr>) : list<cptr> =
    let zl1 = Glue.glist list1 true
    let zl2 = Glue.glist list2 true
    let zr = g_slist_concat zl1 zl2
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    Glue.freeGlist zl2 true
    zv

  extern g_slist_copy : cptr -> cptr

  /// Copies a #GSList.
  [<Unsafe>]
  let copy (list: list<cptr>) : list<cptr> =
    let zl1 = Glue.glist list true
    let zr = g_slist_copy zl1
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    zv

  extern g_slist_copy_deep : cptr -> cptr -> cptr -> cptr

  /// Makes a full (deep) copy of a #GSList.
  [<Unsafe>]
  let copyDeep (list: list<cptr>) (func: cptr -> cptr) : list<cptr> =
    let zcb1 =
      Glue.hold (fun () ->
        let src = Glue.argPointer 0
        Glue.returnPointer (func src))
    let zl2 = Glue.glist list true
    let zr = g_slist_copy_deep zl2 (zgtk_tramp_GLib_CopyFunc ()) zcb1
    let zv = (Glue.pointers (zr) true false)
    Glue.drop zcb1
    Glue.freeGlist zl2 true
    zv

  extern g_slist_delete_link : cptr -> cptr -> cptr

  /// Removes the node link_ from the list and frees it.
  [<Unsafe>]
  let deleteLink (list: list<cptr>) (link: list<cptr>) : list<cptr> =
    let zl1 = Glue.glist list true
    let zl2 = Glue.glist link true
    let zr = g_slist_delete_link zl1 zl2
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    Glue.freeGlist zl2 true
    zv

  extern g_slist_find : cptr -> cptr -> cptr

  /// Finds the element in a #GSList which contains the given data.
  [<Unsafe>]
  let find (list: list<cptr>) (data: cptr) : list<cptr> =
    let zl1 = Glue.glist list true
    let zr = g_slist_find zl1 data
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    zv

  extern g_slist_find_custom : cptr -> cptr -> cptr -> cptr

  /// Finds an element in a #GSList, using a supplied function to find the desired element.
  [<Unsafe>]
  let findCustom (list: list<cptr>) (data: cptr) (func: cptr) : list<cptr> =
    let zl1 = Glue.glist list true
    let zr = g_slist_find_custom zl1 data func
    let zv = (Glue.pointers (zr) true false)
    Glue.freeGlist zl1 true
    zv

  extern g_slist_foreach : cptr -> cptr -> cptr -> unit

  /// Calls a function for each element of a #GSList.
  [<Unsafe>]
  let foreach (list: list<cptr>) (func: cptr -> unit) : unit =
    let zcb1 =
      Glue.hold (fun () ->
        let data = Glue.argPointer 0
        func data)
    let zl2 = Glue.glist list true
    g_slist_foreach zl2 (zgtk_tramp_GLib_Func ()) zcb1
    Glue.drop zcb1
    Glue.freeGlist zl2 true

  extern g_slist_free : cptr -> unit

  /// Frees all of the memory used by a #GSList.
  [<Unsafe>]
  let free (list: list<cptr>) : unit =
    let zl1 = Glue.glist list true
    g_slist_free zl1
