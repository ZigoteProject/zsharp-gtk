/// A convenience function for converting a string to a signed number.
let asciiStringToSigned (str: string) (base: int) (min: int) (max: int) : result<(bool * int), Glue.Error> =
  Glue.outBegin ()
  let zr = g_ascii_string_to_signed str (u32 base) (i64 min) (i64 max) (Glue.out 0) (Glue.err ())
  match Glue.takeError () with
  | Some ze ->
    Glue.outEnd ()
    Error ze
  | None ->
    let zv = (((zr) <> i32 0), Glue.outI64 0)
    Glue.outEnd ()
    Ok zv

