    let zid1 = Glue.wrapBoxed (Glue.outPtr 0) (g_match_info_get_type ()) true
    let zv = (((zr) <> i32 0), (if zid1 = 0 then None else Some (MatchInfo zid1)))
    Glue.outEnd ()
