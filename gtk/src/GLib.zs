module DateTime =
  extern g_date_time_new : cptr -> i32 -> i32 -> i32 -> i32 -> i32 -> f64 -> cptr

  /// Creates a new #GDateTime corresponding to the given date and time in the time zone @tz.
  let create (tz: TimeZone) (year: int) (month: int) (day: int) (hour: int) (minute: int) (seconds: float) : DateTime =
    DateTime (Glue.wrapBoxed ((g_date_time_new (Glue.obj tz.Id (g_time_zone_get_type ())) (i32 year) (i32 month) (i32 day) (i32 hour) (i32 minute) seconds)) (g_date_time_get_type ()) true)

  extern g_date_time_new_from_iso8601 : cstr -> cptr -> cptr

  /// Creates a #GDateTime corresponding to the given [ISO 8601 formatted string](https://en.wikipedia.org/wiki/ISO_8601) @text.
  let createFromIso8601 (text: string) (defaultTz: option<TimeZone>) : DateTime =
    let zp1 =
      match defaultTz with
      | Some zo -> Glue.obj zo.Id (g_time_zone_get_type ())
      | None -> Glue.none ()
    let zr = g_date_time_new_from_iso8601 text zp1
    DateTime (Glue.wrapBoxed (zr) (g_date_time_get_type ()) true)

  extern g_date_time_new_from_timeval_local : cptr -> cptr

  /// Deprecated. Creates a #GDateTime corresponding to the given #GTimeVal @tv in the local time zone.
