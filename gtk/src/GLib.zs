  let zr = g_convert za2 (i64 (Glue.countBytes str)) toCodeset fromCodeset (Glue.out 1) (Glue.out 0) (Glue.err ())
  match Glue.takeError () with
  | Some ze ->
    Glue.outEnd ()
    Glue.free za2
    Error ze
  | None ->
    let zv = (Glue.bytesOf (zr) (Glue.outI64 0) true, Glue.outI64 1)
    Glue.outEnd ()
    Glue.free za2
    Ok zv

