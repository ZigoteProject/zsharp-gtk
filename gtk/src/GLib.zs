  /// IO error.
  let io = IOChannelError 2

  /// File is a directory.
  let isdir = IOChannelError 3

  /// No space left on device.
  let nospc = IOChannelError 4

  /// No such device or address.
  let nxio = IOChannelError 5

  /// Value too large for defined datatype.
