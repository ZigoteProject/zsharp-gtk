module AppInfoCreateFlags =
  /// No flags.
  let none = AppInfoCreateFlags 0

  /// Application opens in a terminal window.
  let needsTerminal = AppInfoCreateFlags 1

  /// Application supports URI arguments.
  let supportsUris = AppInfoCreateFlags 2

  /// Application supports startup notification.
  let supportsStartupNotification = AppInfoCreateFlags 4

module ApplicationFlags =
  /// Deprecated. Default flags.
  let flagsNone = ApplicationFlags 0

  /// Default flags.
  let defaultFlags = ApplicationFlags 0

  /// Run as a service.
  let isService = ApplicationFlags 1

  /// Don't try to become the primary instance.
  let isLauncher = ApplicationFlags 2

  /// This application handles opening files (in the primary instance).
  let handlesOpen = ApplicationFlags 4

  /// This application handles command line arguments (in the primary instance).
  let handlesCommandLine = ApplicationFlags 8

  /// Send the environment of the launching process to the primary instance.
  let sendEnvironment = ApplicationFlags 16

  /// Make no attempts to do any of the typical single-instance application negotiation, even if the application ID is given.
  let nonUnique = ApplicationFlags 32

  /// Allow users to override the application ID from the command line with `--gapplication-app-id`.
  let canOverrideAppId = ApplicationFlags 64

  /// Allow another instance to take over the bus name.
  let allowReplacement = ApplicationFlags 128

  /// Take over from another instance.
  let replace = ApplicationFlags 256

module AskPasswordFlags =
  /// operation requires a password.
  let needPassword = AskPasswordFlags 1

  /// operation requires a username.
  let needUsername = AskPasswordFlags 2

  /// operation requires a domain.
  let needDomain = AskPasswordFlags 4

  /// operation supports saving settings.
  let savingSupported = AskPasswordFlags 8

  /// operation supports anonymous users.
  let anonymousSupported = AskPasswordFlags 16

