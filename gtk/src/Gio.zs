  let serverEndPoint = TlsChannelBindingType 1

  /// [`tls-exporter`](https://www.rfc-editor.org/rfc/rfc9266.html) binding type.
  let exporter = TlsChannelBindingType 2

module TlsDatabaseLookupFlags =
  /// No lookup flags
  let none = TlsDatabaseLookupFlags 0

  /// Restrict lookup to certificates that have a private key.
  let keypair = TlsDatabaseLookupFlags 1

module TlsDatabaseVerifyFlags =
  /// No verification flags
  let none = TlsDatabaseVerifyFlags 0

module TlsError =
  /// No TLS provider is available
  let unavailable = TlsError 0

  /// Miscellaneous TLS error
  let misc = TlsError 1

  /// The certificate presented could not be parsed or failed validation.
  let badCertificate = TlsError 2

  /// The TLS handshake failed because the peer does not seem to be a TLS server.
  let notTls = TlsError 3

  /// The TLS handshake failed because the peer's certificate was not acceptable.
  let handshake = TlsError 4

  /// The TLS handshake failed because the server requested a client-side certificate, but none was provided.
  let certificateRequired = TlsError 5

  /// The TLS connection was closed without proper notice, which may indicate an attack.
  let eof = TlsError 6

  /// The TLS handshake failed because the client sent the fallback SCSV, indicating a protocol downgrade attack.
  let inappropriateFallback = TlsError 7

  /// The certificate failed to load because a password was incorrect.
  let badCertificatePassword = TlsError 8

module TlsInteractionResult =
  /// The interaction was unhandled (i.e.
  let unhandled = TlsInteractionResult 0

  /// The interaction completed, and resulting data is available.
  let handled = TlsInteractionResult 1

  /// The interaction has failed, or was cancelled.
  let failed = TlsInteractionResult 2

module TlsPasswordFlags =
  /// No flags
  let none = TlsPasswordFlags 0

  /// The password was wrong, and the user should retry.
  let retry = TlsPasswordFlags 2

  /// Hint to the user that the password has been wrong many times, and the user may not have many chances left.
  let manyTries = TlsPasswordFlags 4

