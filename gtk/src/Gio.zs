  let createWithBackendAndPath (schemaId: string) (backend: SettingsBackend) (path: string) : Settings =
    Settings (Internal.Raw.wrap ((Internal.GioC.g_settings_new_with_backend_and_path schemaId (Internal.Raw.obj backend.Id (Internal.GioC.g_settings_backend_get_type ())) path)) true)

  /// Creates a new [class@Gio.Settings] object with the relocatable schema specified by @schema_id and a given path.
  let createWithPath (schemaId: string) (path: string) : Settings =
    Settings (Internal.Raw.wrap ((Internal.GioC.g_settings_new_with_path schemaId path)) true)

  /// Applies any changes that have been made to the settings.
  let apply (self: Settings) : unit =
    Internal.GioC.g_settings_apply (Internal.Raw.obj self.Id (Internal.GioC.g_settings_get_type ()))

