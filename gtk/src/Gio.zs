  Internal.Raw.outBegin ()
  let zr = Internal.GioC.g_resources_get_info path (u32 lookupFlags.Int) (Internal.Raw.out 0) (Internal.Raw.out 1) (Internal.Raw.err ())
  match Internal.Raw.takeError () with
  | Some ze ->
    Internal.Raw.outEnd ()
    Error (Glue.error ze)
  | None ->
    let zv = (((zr) <> i32 0), Internal.Raw.outI64 0, Internal.Raw.outU32 1)
    Internal.Raw.outEnd ()
    Ok zv

/// Returns whether the specified @path in the set of globally registered resources has children.
let resourcesHasChildren (path: string) : bool =
  (((Internal.GioC.g_resources_has_children path)) <> i32 0)

/// Looks for a file at the specified @path in the set of globally registered resources and returns a [struct@GLib.Bytes] that lets you directly access the data in memory.
let resourcesLookupData (path: string) (lookupFlags: ResourceLookupFlags) : result<GLib.Bytes, Glue.Error> =
  Internal.Raw.outBegin ()
  let zr = Internal.GioC.g_resources_lookup_data path (u32 lookupFlags.Int) (Internal.Raw.err ())
  match Internal.Raw.takeError () with
  | Some ze ->
    Internal.Raw.outEnd ()
    Error (Glue.error ze)
  | None ->
    let zv = GLib.Bytes (Internal.Raw.wrapBoxed (zr) (Internal.GLibC.g_bytes_get_type ()) true)
    Internal.Raw.outEnd ()
    Ok zv

/// Looks for a file at the specified @path in the set of globally registered resources and returns a [class@Gio.InputStream] that lets you read the data.
let resourcesOpenStream (path: string) (lookupFlags: ResourceLookupFlags) : result<InputStream, Glue.Error> =
  Internal.Raw.outBegin ()
  let zr = Internal.GioC.g_resources_open_stream path (u32 lookupFlags.Int) (Internal.Raw.err ())
  match Internal.Raw.takeError () with
  | Some ze ->
    Internal.Raw.outEnd ()
    Error (Glue.error ze)
  | None ->
    let zv = InputStream (Internal.Raw.wrap (zr) true)
    Internal.Raw.outEnd ()
    Ok zv

/// Registers the resource with the process-global set of resources.
let resourcesRegister (resource: Resource) : unit =
  Internal.GioC.g_resources_register (Internal.Raw.obj resource.Id (Internal.GioC.g_resource_get_type ()))

/// Unregisters the resource from the process-global set of resources.
let resourcesUnregister (resource: Resource) : unit =
  Internal.GioC.g_resources_unregister (Internal.Raw.obj resource.Id (Internal.GioC.g_resource_get_type ()))

/// Deprecated. Reports an error in an idle function.
let simpleAsyncReportGerrorInIdle (object: option<GObject.Object>) (callback: option<GObject.Object> -> AsyncResult -> unit) (error: Glue.Error) : unit =
  let zcb1 =
    Internal.Raw.hold (fun () ->
      let zid2 = Internal.Raw.wrap (Internal.Raw.argPointer 0) false
      let sourceObject = (if zid2 = 0 then None else Some (GObject.Object zid2))
      let res = AsyncResult (Internal.Raw.wrap (Internal.Raw.argPointer 1) false)
      callback sourceObject res)
  let zp3 =
    match object with
    | Some zo -> Internal.Raw.obj zo.Id (Internal.GObjectC.g_object_get_type ())
    | None -> Internal.Raw.none ()
  let ze4 = Internal.Raw.errorNew error.domain error.code error.message
  Internal.GioC.g_simple_async_report_gerror_in_idle zp3 (Internal.GioC.zgtk_tramp_Gio_AsyncReadyCallback_once ()) zcb1 ze4
  Internal.Raw.errorFree ze4

