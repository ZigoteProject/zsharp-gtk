module TlsCertificateRequestFlags =
  /// No flags
  let none = TlsCertificateRequestFlags 0

module TlsChannelBindingError =
  /// Either entire binding retrieval facility or specific binding type is not implemented in the TLS backend.
  let notImplemented = TlsChannelBindingError 0

