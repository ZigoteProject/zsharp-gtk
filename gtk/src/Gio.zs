    Internal.GioC.g_settings_bind_with_mapping_closures (Internal.Raw.obj self.Id (Internal.GioC.g_settings_get_type ())) key (Internal.Raw.obj object.Id (Internal.GObjectC.g_object_get_type ())) property (u32 flags.Int) (Internal.Raw.closure getMapping) (Internal.Raw.closure setMapping)

