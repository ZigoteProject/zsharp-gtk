      | Some zo -> Internal.Raw.obj zo.Id (Internal.GioC.g_settings_backend_get_type ())
      | None -> Internal.Raw.none ()
    let zs2 = Internal.Raw.dupOption path
    let zr = Internal.GioC.g_settings_new_full (Internal.Raw.obj schema.Id (Internal.GioC.g_settings_schema_get_type ())) zp1 zs2
