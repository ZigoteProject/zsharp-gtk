  /// Creates a new [class@Gio.Settings] object with the schema specified by @schema_id.
  let create (schemaId: string) : Settings =
    Settings (Internal.Raw.wrap ((Internal.GioC.g_settings_new schemaId)) true)

  /// Creates a new [class@Gio.Settings] object with a given schema, backend and path.
  let createFull (schema: SettingsSchema) (backend: option<SettingsBackend>) (path: option<string>) : Settings =
    let zp1 =
