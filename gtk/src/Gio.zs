  /// Never allow rehandshaking
  let never = TlsRehandshakeMode 0

  /// Allow safe rehandshaking only
  let safely = TlsRehandshakeMode 1

  /// Allow unsafe rehandshaking
  let unsafely = TlsRehandshakeMode 2

module UnixSocketAddressType =
