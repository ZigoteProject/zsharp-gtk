module Settings =
  /// The same object as its ancestor.
  let toGObjectObject (self: Settings) : GObject.Object = GObject.Object self.Id

  /// The type itself, for `Glue.subclass`, `Glue.isA` and a property's or a signal's types.
  let gtype () : usize = Internal.GioC.g_settings_get_type ()

