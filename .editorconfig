# Editor settings that match Z#'s own (zs fmt: two spaces, 100 columns) and what .gitattributes
# checks out (LF everywhere). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{zs,md}]
max_line_length = 100

[*.py]
indent_size = 4

# expected output is compared byte for byte: an editor changes nothing in it
[*.expected]
insert_final_newline = unset
trim_trailing_whitespace = unset

# generated or copied: left as they come
[{gtk/c/gen/**,gtk/src/internal/*C.zs,gtk/COVERAGE.md,LICENSES/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
max_line_length = unset
